# ============================================================
#  BeanHR Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# ---- Gemini AI -------------------------------------------------
# Get your key at https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=AIza...your_key_here

# ---- Firebase Admin SDK ----------------------------------------
# Download the service account JSON from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#
# Option A (local dev) — path to the downloaded JSON file:
FIREBASE_SERVICE_ACCOUNT_KEY=./beanhr-portal-firebase-adminsdk.json
#
# Option B (cloud deployment) — paste the entire JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"beanhr-portal",...}

# ---- Flask ----------------------------------------------------- 
FLASK_ENV=development
PORT=5000

# ---- CORS ------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# For local dev with VS Code Live Server the default below is fine.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ---- Brevo (Sendinblue) Email Settings -------------------------
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=consultingbeanhr@gmail.com
BREVO_SENDER_NAME="BeanHR"
